  width: 48px;
  height: 48px;
  border-radius: var(--radius);
  object-fit: cover;
}

.bean-cell strong,
.bean-cell span {
  display: block;
}

.bean-cell strong {
  color: #26170c;
}

.bean-cell span {
  color: #62564e;
  font-size: 12px;
}

.admin-tag {
  display: inline-flex;
  border-radius: 999px;
  background: #ffdea5;
  color: #5d4201;
  padding: 5px 9px;
  font-size: 12px;
  font-weight: 800;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 900;
}

.status::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
}

.status.low,
.danger-text {
  color: var(--danger);
}

.status.muted {
  color: #9b928c;
}

.inventory-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 24px;
  color: #62564e;
  font-size: 13px;
  font-weight: 800;
}

.inventory-footer div {
  display: flex;
  gap: 8px;
}

.inventory-footer button {
  width: 36px;
  height: 36px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fff;
  color: #26170c;
  font-weight: 900;
}

.admin-secondary-grid {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
  gap: 24px;
  margin-top: 28px;
}

.roaster-note {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 24px;
  align-items: center;
  border: 1px solid rgba(216, 203, 194, 0.7);
  border-radius: var(--radius);
  background: #fdfcfb;
  padding: 24px;
}

.roaster-note img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--radius);
  object-fit: cover;
}

.roaster-note p {
  margin-bottom: 0;
  font-weight: 800;
}

.shipment-feed {
  padding: 22px;
}

.shipment-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 18px;
}

.shipment-heading button {
  border: 0;
  background: transparent;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.shipment-item {
  display: flex;
  gap: 14px;
  padding: 14px 0;
}

.shipment-item + .shipment-item {
  border-top: 1px solid rgba(216, 203, 194, 0.58);
}

.shipment-item > span {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #ccead6;
  color: #062014;
  flex: 0 0 auto;
}

.shipment-item strong {
  color: #26170c;
}

.shipment-item p {
  margin: 3px 0 0;
  font-size: 13px;
}

.report-grid {
  margin-bottom: 0;
}

.settings-panel {
  overflow: hidden;
}

.settings-list {
  display: grid;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  border-top: 1px solid rgba(216, 203, 194, 0.58);
  padding: 18px 24px;
}

.settings-row span {
  color: #62564e;
  font-weight: 800;
}

.settings-row strong {
  color: #26170c;
}

@media (max-width: 1100px) {
  .admin-shell {
    grid-template-columns: 86px minmax(0, 1fr);
  }

  .admin-brand div,
  .admin-nav button,
  .admin-logout {
    font-size: 0;
  }

  .admin-brand {
    justify-content: center;
    padding-inline: 0;
  }

  .admin-nav button,
  .admin-logout {
    justify-content: center;
    padding: 0;
  }

  .admin-stats,
  .admin-secondary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .roaster-note {
    grid-column: 1 / -1;
  }
}

@media (max-width: 760px) {
  .admin-shell {
    display: block;
  }

  .admin-sidebar {
    position: static;
    height: auto;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .admin-brand div,
  .admin-nav button,
  .admin-logout {
    font-size: inherit;
  }

  .admin-nav {
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .admin-header,
  .admin-page-heading,
  .inventory-toolbar,
  .inventory-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-header-actions {
    flex-wrap: wrap;
  }

  .admin-main {
    width: min(100% - 32px, 1280px);
  }

  .admin-stats,
  .admin-secondary-grid,
  .roaster-note {
    grid-template-columns: 1fr;
  }
}
</file>

