<file path="README.md">
# Coffee Platform Frontend

Farm to Cup is now a single Vite React application instead of four separate
static HTML screens.

## What is included

- Home/shop experience with shared product data
- Product detail view
- Interactive flavor quiz with recommendation logic
- Cart with quantity controls, removal, and subscription discount
- Shared header, footer, visual system, and responsive CSS

The old HTML files remain in `pages/` as legacy reference material. The running
app starts from `index.html` and `src/main.jsx`.

## Run locally

On Windows PowerShell, use `npm.cmd` if script execution policy blocks `npm`.

```bash
npm.cmd install
npm.cmd run dev
```

Build for production:

```bash
npm.cmd run build
```
</file>

<file path="src/App.jsx">
import {
  ArrowLeft,
  ArrowRight,
  Award,
  Coffee,
  Heart,
  Leaf,
  Minus,
  Plus,
  ShoppingBag,
  Sparkles,
  Star,
  Trash2,
  User,
} from "lucide-react";
import { useEffect, useMemo, useState } from "react";

const products = [
  {
    id: "dalat-red-bourbon",
    name: "Dalat Red Bourbon",
    origin: "Lam Dong, Vietnam",
    price: 28,
    roast: "Medium",
    process: "Washed",
    notes: ["Cacao", "Orange peel", "Brown sugar"],
    brew: ["Pour over", "Phin", "French press"],
    image:
      "https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1200&q=80",
    story:
      "A high-altitude lot with a clean cup, rounded sweetness, and a calm chocolate finish.",
    badge: "Farmer direct",
  },
  {
    id: "ethiopia-yirgacheffe",
    name: "Ethiopia Yirgacheffe",
    origin: "Gedeo, Ethiopia",
    price: 32,
    roast: "Light",
    process: "Washed",
    notes: ["Jasmine", "Lemon zest", "Honey"],
    brew: ["Pour over", "Aeropress"],
    image:
      "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1200&q=80",
    story:
      "A bright single origin built for clarity, florals, and a crisp finish.",
    badge: "Limited release",
  },
  {
    id: "sumatra-mandheling",
    name: "Sumatra Mandheling",
    origin: "Aceh, Indonesia",
    price: 30,
    roast: "Dark",
    process: "Wet hulled",
    notes: ["Cedar", "Spice", "Molasses"],
    brew: ["Espresso", "French press", "Moka pot"],
    image:
      "https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=1200&q=80",
    story:
      "Dense, low-acidity coffee for people who like body, spice, and a long finish.",
    badge: "Roaster pick",
  },
];

const quizQuestions = [
  {
    title: "How do you brew?",
    options: ["Pour over", "Phin", "Espresso", "French press"],
  },
  {
    title: "What flavor direction do you like?",
    options: ["Bright and floral", "Chocolatey", "Bold and earthy", "Sweet and balanced"],
  },
  {
    title: "How intense should the cup feel?",
    options: ["Light", "Medium", "Strong"],
  },
];

function money(value) {
  return `$${value.toFixed(2)}`;
}

function useRouter() {
  const getRoute = () => window.location.hash.replace("#", "") || "/";
  const [route, setRoute] = useState(getRoute);

  useEffect(() => {
    const onHashChange = () => setRoute(getRoute());
    window.addEventListener("hashchange", onHashChange);
    return () => window.removeEventListener("hashchange", onHashChange);
  }, []);

  const navigate = (nextRoute) => {
    window.location.hash = nextRoute;
    setRoute(nextRoute);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  return { route, navigate };
}

export default function App() {
  const { route, navigate } = useRouter();
  const [cart, setCart] = useState([
    { productId: "dalat-red-bourbon", qty: 1, subscription: true },
  ]);

  const activeProduct =
    products.find((product) => route === `/product/${product.id}`) || products[0];

  const cartCount = cart.reduce((sum, item) => sum + item.qty, 0);

  const addToCart = (productId) => {
    setCart((items) => {
      const existing = items.find((item) => item.productId === productId);
      if (existing) {
        return items.map((item) =>
          item.productId === productId ? { ...item, qty: item.qty + 1 } : item
        );
      }
      return [...items, { productId, qty: 1, subscription: false }];
    });
    navigate("/cart");
  };

  return (
    <div className="app-shell">
      <Header route={route} navigate={navigate} cartCount={cartCount} />
      {route === "/" && <Home navigate={navigate} addToCart={addToCart} />}
      {route.startsWith("/product/") && (
        <ProductDetail product={activeProduct} addToCart={addToCart} navigate={navigate} />
      )}
      {route === "/quiz" && <FlavorQuiz navigate={navigate} addToCart={addToCart} />}
      {route === "/cart" && <Cart cart={cart} setCart={setCart} navigate={navigate} />}
      <Footer navigate={navigate} />
    </div>
  );
}

function Header({ route, navigate, cartCount }) {
  const links = [
    { label: "Shop", route: "/" },
    { label: "Discovery", route: "/quiz" },
    { label: "Roastery", route: "/product/dalat-red-bourbon" },
    { label: "Cart", route: "/cart" },
  ];

  return (
    <header className="site-header">
      <button className="brand" onClick={() => navigate("/")}>
        Farm to Cup
      </button>
      <nav className="nav-links" aria-label="Primary navigation">
        {links.map((link) => (
          <button
            key={link.route}
            className={route === link.route ? "active" : ""}
            onClick={() => navigate(link.route)}
          >
            {link.label}
          </button>
        ))}
      </nav>
      <div className="header-actions">
        <button className="icon-button" onClick={() => navigate("/cart")} aria-label="Open cart">
          <ShoppingBag size={20} />
          {cartCount > 0 && <span>{cartCount}</span>}
        </button>
        <button className="icon-button" aria-label="Account">
          <User size={20} />
        </button>
      </div>
    </header>
  );
}

function Home({ navigate, addToCart }) {
  return (
    <main>
      <section className="hero">
        <div className="hero-copy">
          <p className="eyebrow">The art of the brew</p>
          <h1>From Soil to Soul</h1>
          <p>
            A farmer-direct coffee platform that helps customers discover origins,
            compare flavor profiles, and build a better morning ritual.
          </p>
          <div className="button-row">
            <button className="primary-button" onClick={() => document.getElementById("shop")?.scrollIntoView()}>
