  grid-template-columns: 150px minmax(0, 1fr);
  gap: 20px;
  padding: 18px;
  box-shadow: none;
}

.cart-item img {
  width: 150px;
  height: 170px;
  border-radius: var(--radius);
  object-fit: cover;
}

.subscription-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 10px 0 18px;
  color: var(--secondary);
  font-weight: 800;
}

.quantity-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 40px;
  height: 40px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface-high);
  color: var(--primary);
}

.quantity-row span {
  min-width: 28px;
  text-align: center;
  font-weight: 800;
}

.remove-button {
  padding: 0 12px;
  color: var(--danger) !important;
}

.summary {
  position: sticky;
  top: 98px;
  padding: 24px;
}

.summary h2 {
  margin-bottom: 22px;
}

.summary-line {
  padding: 11px 0;
  color: var(--muted);
}

.summary-total {
  margin: 14px 0 20px;
  border-top: 1px solid var(--line);
  padding-top: 18px;
  font-size: 22px;
}

.empty-state {
  display: grid;
  place-items: center;
  gap: 14px;
  min-height: 320px;
  padding: 28px;
  box-shadow: none;
}

.site-footer {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 36px 32px;
  border-top: 1px solid var(--line);
  background: var(--surface-low);
}

.site-footer p {
  max-width: 560px;
  margin-bottom: 0;
}

@media (max-width: 880px) {
  .site-header {
    grid-template-columns: 1fr auto;
    padding: 0 18px;
  }

  .nav-links {
    grid-column: 1 / -1;
    justify-content: flex-start;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .hero {
    min-height: 680px;
    padding: 64px 24px;
  }

  .product-grid,
  .story-band,
  .product-detail,
  .result-card,
  .cart-page {
    grid-template-columns: 1fr;
  }

  .journey-grid,
  .detail-stats,
  .quiz-options {
    grid-template-columns: 1fr;
  }

  .gallery img {
    min-height: 420px;
  }

  .cart-item {
    grid-template-columns: 1fr;
  }

  .cart-item img {
    width: 100%;
    height: 240px;
  }

  .summary {
    position: static;
  }

  .site-footer {
    flex-direction: column;
  }
}
