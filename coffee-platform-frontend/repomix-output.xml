function ProductDetail({ product, addToCart, navigate }) {
  return (
    <main className="detail-page">
      <button className="back-button" onClick={() => navigate("/")}>
        <ArrowLeft size={18} /> Back to shop
      </button>
      <section className="product-detail">
        <div className="gallery">
          <img src={product.image} alt={`${product.name} package`} />
        </div>
        <div className="detail-copy">
          <div className="badge-line">
            <span>{product.badge}</span>
            <span>{product.process}</span>
          </div>
          <h1>{product.name}</h1>
          <p className="origin">{product.origin}</p>
          <p>{product.story}</p>
          <div className="detail-stats">
            <Metric icon={<Star />} label="Roast" value={product.roast} />
            <Metric icon={<Sparkles />} label="Process" value={product.process} />
            <Metric icon={<Coffee />} label="Price" value={money(product.price)} />
          </div>
          <div className="detail-panel">
            <h3>Flavor profile</h3>
            <div className="chip-row">
              {product.notes.map((note) => (
                <span key={note}>{note}</span>
              ))}
            </div>
          </div>
          <div className="detail-panel">
            <h3>Best for</h3>
            <div className="chip-row">
              {product.brew.map((method) => (
                <span key={method}>{method}</span>
              ))}
            </div>
          </div>
          <button className="primary-button wide" onClick={() => addToCart(product.id)}>
            Add to cart - {money(product.price)}
          </button>
