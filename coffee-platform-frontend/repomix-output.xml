.hero p {
  max-width: 600px;
  color: #f5ece2;
  font-size: 19px;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--accent);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.button-row,
.card-actions,
.quantity-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.primary-button,
.secondary-button,
.back-button {
  min-height: 48px;
  border-radius: var(--radius);
  border: 1px solid transparent;
  padding: 0 20px;
  font-weight: 800;
}

.primary-button {
  background: var(--primary);
  color: #fff;
}

.primary-button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.secondary-button,
.back-button {
  background: var(--surface-high);
  border-color: var(--line);
  color: var(--primary);
}

.compact {
  min-height: 40px;
  padding: 0 14px;
}

.wide {
  width: 100%;
}

.section,
.quiz-page,
.detail-page,
.cart-page {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
  padding: 82px 0;
}

.section-heading {
  margin-bottom: 30px;
}

.section-heading.centered {
  max-width: 720px;
  text-align: center;
}

.section-heading h1,
.section-heading h2 {
  font-size: clamp(36px, 5vw, 58px);
}

.section-heading p {
  max-width: 660px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.product-card,
.quiz-card,
.result-card,
.summary,
.empty-state,
.cart-item,
.detail-panel {
  border: 1px solid rgba(216, 203, 194, 0.72);
  border-radius: var(--radius);
  background: var(--surface-high);
  box-shadow: var(--shadow);
}

.product-card {
  overflow: hidden;
}

.product-card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.product-card-body {
  padding: 22px;
}

.card-topline,
.cart-title-row,
.summary-line,
.summary-total {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
}

.card-topline span,
.badge-line span {
  border-radius: 999px;
  background: rgba(73, 100, 85, 0.12);
  color: var(--secondary);
  padding: 6px 10px;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
}

.product-card h3 {
  margin-top: 16px;
  font-size: 28px;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 18px 0;
}

.chip-row span {
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface-low);
  color: var(--primary);
  padding: 7px 10px;
  font-size: 13px;
  font-weight: 700;
}

.story-band {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 42px;
  align-items: center;
  padding: 70px max(24px, calc((100vw - 1180px) / 2));
  background: var(--primary);
}

.story-band h2 {
  color: #fff;
  font-size: clamp(34px, 5vw, 58px);
}

.journey-grid,
.detail-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.metric {
  min-height: 128px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  padding: 18px;
}

.detail-stats .metric {
  background: var(--surface-low);
  border-color: var(--line);
  color: var(--primary);
}

.metric span,
.metric strong {
  display: block;
  margin-top: 10px;
}

.metric span {
  color: inherit;
  opacity: 0.72;
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 22px;
}

.product-detail {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
  gap: 42px;
  align-items: start;
}

.gallery img {
  width: 100%;
  min-height: 620px;
  border-radius: var(--radius);
  object-fit: cover;
  box-shadow: var(--shadow);
}

.detail-copy h1 {
  margin-top: 16px;
  font-size: clamp(42px, 6vw, 70px);
}

.origin {
  font-weight: 800;
}

.badge-line {
  display: flex;
  gap: 10px;
}

.detail-panel {
  margin: 18px 0;
  padding: 20px;
  box-shadow: none;
}

.quiz-card,
.result-card {
  width: min(900px, 100%);
  margin: 0 auto;
  padding: 28px;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
}

.progress-track {
  height: 8px;
  margin: 14px 0 28px;
  overflow: hidden;
  border-radius: 999px;
  background: var(--surface-low);
}

.progress-track div {
  height: 100%;
  background: var(--secondary);
}

.quiz-card h2 {
  font-size: 34px;
}

.quiz-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 24px;
}

.quiz-options button {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 76px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface-low);
  color: var(--primary);
  padding: 0 18px;
  font-weight: 800;
}

.quiz-options button:hover {
  border-color: var(--primary);
  background: #fff;
}

.result-card {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 28px;
  align-items: center;
}

.result-card img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--radius);
  object-fit: cover;
}

.cart-page {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 380px;
  gap: 28px;
  align-items: start;
}

.cart-items {
  display: grid;
  gap: 16px;
}

.cart-item {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  gap: 20px;
  padding: 18px;
  box-shadow: none;
}

.cart-item img {
  width: 150px;
  height: 170px;
  border-radius: var(--radius);
  object-fit: cover;
}

.subscription-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 10px 0 18px;
  color: var(--secondary);
  font-weight: 800;
}

.quantity-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 40px;
  height: 40px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface-high);
  color: var(--primary);
}

.quantity-row span {
  min-width: 28px;
  text-align: center;
  font-weight: 800;
}

.remove-button {
  padding: 0 12px;
  color: var(--danger) !important;
}

.summary {
  position: sticky;
  top: 98px;
  padding: 24px;
}

.summary h2 {
  margin-bottom: 22px;
}

.summary-line {
  padding: 11px 0;
  color: var(--muted);
}

.summary-total {
  margin: 14px 0 20px;
  border-top: 1px solid var(--line);
  padding-top: 18px;
  font-size: 22px;
}

.empty-state {
  display: grid;
  place-items: center;
  gap: 14px;
  min-height: 320px;
  padding: 28px;
  box-shadow: none;
}

.site-footer {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 36px 32px;
  border-top: 1px solid var(--line);
  background: var(--surface-low);
}

.site-footer p {
  max-width: 560px;
  margin-bottom: 0;
}

@media (max-width: 880px) {
  .site-header {
    grid-template-columns: 1fr auto;
    padding: 0 18px;
  }

  .nav-links {
    grid-column: 1 / -1;
    justify-content: flex-start;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .hero {
    min-height: 680px;
    padding: 64px 24px;
  }

  .product-grid,
  .story-band,
  .product-detail,
  .result-card,
  .cart-page {
    grid-template-columns: 1fr;
  }

  .journey-grid,
  .detail-stats,
  .quiz-options {
    grid-template-columns: 1fr;
  }

  .gallery img {
    min-height: 420px;
  }

  .cart-item {
    grid-template-columns: 1fr;
  }

  .cart-item img {
    width: 100%;
    height: 240px;
  }

  .summary {
    position: static;
  }

  .site-footer {
    flex-direction: column;
  }
}
