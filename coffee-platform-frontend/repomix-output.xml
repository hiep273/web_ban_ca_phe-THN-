        <div className="hero-copy">
          <p className="eyebrow">The art of the brew</p>
          <h1>From Soil to Soul</h1>
          <p>
            A farmer-direct coffee platform that helps customers discover origins,
            compare flavor profiles, and build a better morning ritual.
          </p>
          <div className="button-row">
            <button className="primary-button" onClick={() => document.getElementById("shop")?.scrollIntoView()}>
              Explore origins
            </button>
            <button className="secondary-button" onClick={() => navigate("/quiz")}>
              Take flavor quiz
            </button>
          </div>
        </div>
      </section>

      <section className="section" id="shop">
        <div className="section-heading">
          <p className="eyebrow">Seasonal collection</p>
          <h2>Find Your Flavor</h2>
          <p>Shop by origin, roast, process, and the sensory notes that matter.</p>
        </div>
        <div className="product-grid">
          {products.map((product) => (
            <ProductCard
              key={product.id}
              product={product}
              onView={() => navigate(`/product/${product.id}`)}
              onAdd={() => addToCart(product.id)}
            />
          ))}
        </div>
      </section>

      <section className="story-band">
        <div>
          <p className="eyebrow">Traceable sourcing</p>
          <h2>Built around the journey from farm to cup.</h2>
        </div>
        <div className="journey-grid">
          <Metric icon={<Leaf />} label="Origin" value="3 regions" />
          <Metric icon={<Award />} label="Quality" value="Q-graded lots" />
          <Metric icon={<Coffee />} label="Craft" value="Roasted weekly" />
